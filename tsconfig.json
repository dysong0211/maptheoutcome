    ".next-simple-pages/types/**/*.ts",
    ".next-simple/types/**/*.ts",
    ".next-source-clarity/types/**/*.ts",
    ".next-source-workflow-final/types/**/*.ts",
    ".next-source-workflow/types/**/*.ts",
    ".next-tech-lime/types/**/*.ts",
