{
  "name": "maptoc",
  "version": "0.1.0",
  "private": true,
  "description": "Outcome-focused program management and evidence mapping infrastructure.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "test": "node scripts/test-program-memory.cjs && node scripts/test-evidence-lookup.cjs && node scripts/test-evidence-support.cjs && node scripts/test-live-ai.cjs && node scripts/test-transparency.cjs && node scripts/test-outcome-trail.cjs && node scripts/test-resilience-pipeline.cjs && node scripts/test-gemini.cjs && node scripts/test-pilot-fixes.cjs && node scripts/test-pilot-changes.cjs && node scripts/test-program-ids.cjs && node scripts/test-insight-review.cjs && node scripts/test-report-visuals.cjs && node scripts/test-projects.cjs && node scripts/test-outcome-links.cjs",
    "test:ai": "node scripts/test-live-ai.cjs && node scripts/test-gemini.cjs",
    "test:memory": "node scripts/test-program-memory.cjs",
    "test:evidence": "node scripts/test-evidence.cjs",
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:website": "node scripts/build-website.mjs",
    "preview:website": "node scripts/preview-website.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@prisma/client": "^6.15.0",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.542.0",
    "mammoth": "^1.12.3",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.2",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "prisma": "^6.15.0",
    "tailwindcss": "^4.1.12",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5.9.2"
  }
