# Server-side only. Copy to .env.local. Never commit real secrets.
AI_PROVIDER=gemini
MAPTOC_AI_ENABLED=false
GEMINI_API_KEY=
# Use a model available to your provider project.
GEMINI_MODEL=gemini-3.6-flash
# Optional alternative provider, selected only by AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Hosted pilot: use a strong private code and independent session secret.
MAPTOC_ACCESS_CODE_ENABLED=false
NEXT_PUBLIC_MAPTOC_ACCESS_CODE_ENABLED=false
MAPTOC_REQUIRE_AUTH=false
MAPTOC_ACCESS_CODE=
MAPTOC_ACCESS_SESSION_SECRET=
MAPTOC_APP_ORIGIN=http://localhost:3000
# Role switching remains a demo convenience, never RBAC.
NEXT_PUBLIC_MAPTOC_PILOT_MODE=false
